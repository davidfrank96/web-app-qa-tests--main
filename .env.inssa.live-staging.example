# Copy to .env.inssa.live-staging and fill credentials locally.
# This profile is for https://staging.inssa.us only. Never point live mutation tests at production.

INSSA_URL=https://staging.inssa.us

# Required authenticated QA account credentials. Do not commit real values.
INSSA_TEST_EMAIL=
INSSA_TEST_PASSWORD=

# Live staging mutation gates.
INSSA_ENABLE_LIVE_CAPSULE_TESTS=1
INSSA_LIVE_CAPSULE_MANUAL_CLEANUP_APPROVED=1
INSSA_ENABLE_MEDIA_CAPSULE_TESTS=1
INSSA_ENABLE_REVEAL_LATER_CAPSULE_TESTS=1
INSSA_ENABLE_VIDEO_CAPSULE_TESTS=1
INSSA_ENABLE_MUTATION_TESTS=1

# Single selected US market for live media/video runs.
INSSA_US_MARKET_LOCATION=nyc

# Optional deterministic run grouping.
INSSA_MUTATION_RUN_TOKEN=

# Optional remote-image mode for media tests. Leave disabled unless intentionally testing it.
INSSA_ENABLE_REMOTE_IMAGE_TESTS=0
INSSA_TEST_REMOTE_IMAGE_URL=

# Optional local video fixture override. If blank, the video test uses tests/fixtures/media/sample-video.mp4.
INSSA_TEST_VIDEO_FIXTURE_PATH=

# Artifact-dependent read-only lifecycle tests.
INSSA_LIVE_CAPSULE_ARTIFACT_PATH=
INSSA_USE_LATEST_LIVE_CAPSULE_ARTIFACT=1

# Optional lifecycle diagnostics.
# Enables sanitized post-Bury/post-Continue request and response body capture in lifecycle artifacts.
INSSA_DEBUG_LIFECYCLE_NETWORK=0

# Optional read-only discovery delay before a second surface probe. Default is no delay.
INSSA_DISCOVERY_DELAY_MS=0

# Optional security input/reflection probes. Keep disabled unless intentionally auditing draft-side input handling.
INSSA_ENABLE_SECURITY_INPUT_PROBES=0

# Investigation-only; keep disabled unless diagnosing Bury navigation failures.
INSSA_ENABLE_BURY_NAV_AUDIT=0

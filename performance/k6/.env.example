BASE_URL=https://staging.inssa.us
KBEAN_BACKEND_BASE_URL=https://kbeanbetastaging.azurewebsites.net
FIREBASE_IDENTITY_TOOLKIT_BASE_URL=https://identitytoolkit.googleapis.com/v1

FIREBASE_LOGIN_PATH=/accounts:signInWithPassword
FIREBASE_LOOKUP_PATH=/accounts:lookup
KBEAN_SOCIAL_LOGIN_JWT_PATH=/Account/SocialLoginJWT
KBEAN_SOCIAL_AUTHENTICATE_PATH=/Account/SocialAuthenticate
KBEAN_PROFILE_BY_EMAIL_PATH=/api/public/GetUserProfileByEmail

FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_GMP_ID=REPLACE_WITH_FIREBASE_GMP_ID
KBEAN_PUBLIC_API_KEY=REPLACE_WITH_KBEAN_PUBLIC_API_KEY

USERS_FILE=../data/users.json
TEST_PROFILE=smoke
MAX_VUS=2
REQUEST_TIMEOUT=10s
ALLOW_ACCOUNT_REUSE=false

ALLOW_PRODUCTION_LOAD_TEST=false
PRODUCTION_CONFIRMATION=

# Controlled staging infrastructure tests may explicitly set this to true when
# there are fewer dedicated test accounts than VUs. Results then represent
# authentication pipeline capacity, not unique-user capacity.

{
  "name": "web-app-qa-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright QA framework for Local Man, KBean, INSSA, and other web apps.",
  "scripts": {
    "test": "playwright test",
    "test:localman": "playwright test --project=localman-chrome",
    "test:kbean": "playwright test --project=kbean-chrome",
    "test:inssa": "playwright test --project=inssa-chrome",
    "test:inssa:safe": "playwright test tests/inssa/inssa-time-capsule-create.spec.ts tests/inssa/us-compose-location-matrix.spec.ts tests/inssa/media-step-capability.spec.ts --project=inssa-chrome",
    "test:inssa:live-staging": "npm run test:inssa:live-text && npm run test:inssa:discovery && npm run test:inssa:public-share && npm run test:inssa:live-media && npm run test:inssa:live-video && npm run test:inssa:reveal-later && npm run test:inssa:cleanup-audit",
    "test:inssa:live-text": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-create.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:live-media": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-media-create.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:live-video": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-video-create.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:reveal-later": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-reveal-later-create.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:discovery": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-authenticated-discovery.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:public-share": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-public-share-lifecycle.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:cleanup-audit": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/live-capsule-cleanup-capability-audit.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:draft-mutations": "set -a; . ./.env.inssa.live-staging; set +a; playwright test tests/inssa/draft-write-cleanup.spec.ts tests/inssa/draft-restore-hydration.spec.ts --project=inssa-chrome --workers=1 --retries=0",
    "test:inssa:campaign:text": "node scripts/inssa/run-lifecycle-campaign.js text",
    "test:inssa:campaign:media": "node scripts/inssa/run-lifecycle-campaign.js media",
    "test:inssa:campaign:video": "node scripts/inssa/run-lifecycle-campaign.js video",
    "test:inssa:campaign:reveal-later": "node scripts/inssa/run-lifecycle-campaign.js reveal-later",
    "test:inssa:campaign:security": "node scripts/inssa/run-security-campaign.js",
    "report:show": "playwright show-report playwright-report",
    "report:open": "playwright show-report playwright-report",
    "report:security": "node scripts/inssa/render-campaign-report.js security",
    "report:lifecycle": "node scripts/inssa/render-campaign-report.js lifecycle",
    "test:mobile": "playwright test --project=mobile-chrome",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "npm --prefix dashboard run start",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^25.6.0",
    "dotenv": "latest",
    "typescript": "latest"
  }
}

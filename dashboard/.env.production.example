# Production host template for the QA Operations Platform. The platform still
# targets INSSA staging. Keep this file value-free and load real secrets from a
# root-owned service environment file on the host.

NEXT_PUBLIC_SUPABASE_URL=https://your-qa-platform-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://your-qa-platform-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

INSSA_OPS_METADATA_STORE=supabase
INSSA_EVIDENCE_STORAGE_PROVIDER=supabase
INSSA_EVIDENCE_SUPABASE_BUCKET=inssa-evidence

INSSA_URL=https://staging.inssa.us
INSSA_QA_REPO_ROOT=/opt/qa-platform
INSSA_WORKER_POLL_MS=1000
INSSA_WORKER_LEASE_MS=30000
INSSA_SCHEDULER_INTERVAL_MS=60000

INSSA_OPS_VIEWER_EMAILS=
INSSA_OPS_OPERATOR_EMAILS=
INSSA_OPS_ADMIN_EMAILS=

INSSA_TEST_EMAIL=
INSSA_TEST_PASSWORD=
INSSA_SECONDARY_TEST_EMAIL=
INSSA_SECONDARY_TEST_PASSWORD=

# Scheduled authentication monitoring is disabled in the database for the
# first deployment. These credentials are optional until controlled testing.
AUTH_MONITOR_STAGING_EMAIL=
AUTH_MONITOR_STAGING_PASSWORD=
AUTH_MONITOR_STAGING_GOOGLE_EMAIL=
AUTH_MONITOR_STAGING_GOOGLE_PASSWORD=
AUTH_MONITOR_STAGING_APPLE_EMAIL=
AUTH_MONITOR_STAGING_APPLE_PASSWORD=
AUTH_MONITOR_ALLOW_PRODUCTION=0
AUTH_MONITOR_PRODUCTION_CONFIRMATION=

# Live mutation campaigns remain fail-closed for the first deployment.
INSSA_ENABLE_LIVE_CAPSULE_TESTS=0
INSSA_ENABLE_MUTATION_TESTS=0

# SIEM delivery remains separately approval-gated.
SIEM_WAZUH_URL=
SIEM_WAZUH_TOKEN=
SIEM_DRY_RUN=1
SIEM_SEND_BATCH=0

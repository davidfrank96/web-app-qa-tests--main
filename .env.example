# Repository environment reference. Copy only the variables needed by the
# workflow into an ignored .env file. Never commit real values.

# Product targets
LOCALMAN_URL=http://localhost:3000
KBEAN_URL=https://your-kbean-staging-url.example
INSSA_URL=https://staging.inssa.us

# Product credentials
LOCALMAN_ADMIN_EMAIL=
LOCALMAN_ADMIN_PASSWORD=
KBEAN_TEST_EMAIL=
KBEAN_TEST_PASSWORD=
INSSA_TEST_EMAIL=
INSSA_TEST_PASSWORD=
INSSA_SECONDARY_TEST_EMAIL=
INSSA_SECONDARY_TEST_PASSWORD=

# Supabase browser authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-key fallback; prefer the publishable key variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server authentication and persistence
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Metadata and evidence providers
INSSA_OPS_METADATA_STORE=local
INSSA_EVIDENCE_STORAGE_PROVIDER=local
INSSA_EVIDENCE_SUPABASE_BUCKET=inssa-evidence

# Worker and scheduler
INSSA_WORKER_POLL_MS=1000
INSSA_WORKER_HEARTBEAT_MS=15000
INSSA_WORKER_HEARTBEAT_FAILURE_LIMIT=3
INSSA_WORKER_LEASE_MS=120000
INSSA_WORKER_TERMINATION_GRACE_MS=10000
INSSA_SCHEDULER_INTERVAL_MS=60000
# Optional when dashboard services run outside the repository root.
INSSA_QA_REPO_ROOT=

# Dashboard role fallbacks. Supabase app_metadata.inssa_ops_role takes priority.
INSSA_OPS_VIEWER_EMAILS=
INSSA_OPS_OPERATOR_EMAILS=
INSSA_OPS_ADMIN_EMAILS=

# Authentication monitoring: staging email/password falls back to INSSA_TEST_*.
AUTH_MONITOR_STAGING_EMAIL=
AUTH_MONITOR_STAGING_PASSWORD=
AUTH_MONITOR_STAGING_GOOGLE_EMAIL=
AUTH_MONITOR_STAGING_GOOGLE_PASSWORD=
AUTH_MONITOR_STAGING_APPLE_EMAIL=
AUTH_MONITOR_STAGING_APPLE_PASSWORD=
AUTH_MONITOR_STAGING_METHODS=username-password,google-oauth,apple-sign-in

# Production authentication monitoring is disabled unless both safeguards match.
AUTH_MONITOR_ALLOW_PRODUCTION=0
AUTH_MONITOR_PRODUCTION_CONFIRMATION=
AUTH_MONITOR_PRODUCTION_EMAIL=
AUTH_MONITOR_PRODUCTION_PASSWORD=
AUTH_MONITOR_PRODUCTION_GOOGLE_EMAIL=
AUTH_MONITOR_PRODUCTION_GOOGLE_PASSWORD=
AUTH_MONITOR_PRODUCTION_APPLE_EMAIL=
AUTH_MONITOR_PRODUCTION_APPLE_PASSWORD=
AUTH_MONITOR_PRODUCTION_METHODS=username-password,google-oauth,apple-sign-in

# SIEM sender. Compatibility aliases are documented below.
SIEM_WAZUH_URL=https://wazuh.example.com/inssa
SIEM_WAZUH_TOKEN=
SIEM_DRY_RUN=0
SIEM_SEND_BATCH=0
WAZUH_WEBHOOK_URL=
WAZUH_URL=
WAZUH_API_TOKEN=
WAZUH_TOKEN=
PLATFORM_HEALTHCHECK_INGESTION_URL=

# Wazuh ingestion service. Store production values in /etc/inssa-ingestion.env.
INSSA_INGEST_SHARED_TOKEN=
INSSA_INGEST_HOST=127.0.0.1
INSSA_INGEST_PORT=8088
INSSA_INGEST_PATH=/inssa
INSSA_INGEST_MAX_BODY_BYTES=1048576
INSSA_INGEST_EVENT_LOG_PATH=/var/ossec/logs/inssa-qa.log
INSSA_INGEST_REQUEST_LOG_PATH=/var/ossec/logs/inssa-qa-ingestion-requests.log
INSSA_INGEST_FAILURE_LOG_PATH=/var/ossec/logs/inssa-qa-ingestion-errors.log

# Playwright output overrides are normally set by the worker per run.
PLAYWRIGHT_OUTPUT_DIR=
PLAYWRIGHT_HTML_OUTPUT_DIR=

# Generic CLI load scripts
VUS=1
DURATION=30s
SEARCH_TERMS=
LOCALMAN_VENDOR_SLUG=
